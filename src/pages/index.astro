---
import { withBase } from '../lib/paths';
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import Architecture from '../components/Architecture.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
const allArticles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const articles = allArticles.slice(0, 3);
const projects = (await getCollection('projects')).filter(project => project.data.featured);
---
<SiteLayout>
  <div class="shell">
    <header class="home-intro">
      <div class="home-intro-copy">
        <h1>未竟之事</h1>
        <p class="home-invitation">来吧！<br />我们要建造一座城和一座塔。</p>
      </div>
      <figure class="home-drawing"><Architecture /></figure>
    </header>
    <div class="home-collections">
      <section class="home-city" aria-labelledby="articles-title">
        <div class="section-top">
          <h2 id="articles-title">城中之囚</h2>
          <a class="text-link" href={withBase('/articles/')} aria-label="全部文章">全部文章 <span aria-hidden="true">↗</span></a>
        </div>
        {articles.length ? <div class="article-list">{articles.map(entry => <ArticleCard entry={entry} />)}</div> :
          <p class="empty-state">暂无文章。</p>}
      </section>
      <section class="home-tower" aria-labelledby="projects-title">
        <div class="section-top">
          <h2 id="projects-title">筑塔之人</h2>
          <a class="text-link" href={withBase('/projects/')} aria-label="全部项目">全部项目 <span aria-hidden="true">↗</span></a>
        </div>
        {projects.length ? <div class="project-list">{projects.map((entry, index) => <ProjectCard entry={entry} index={index} />)}</div> : <p class="empty-state">暂无项目。</p>}
      </section>
    </div>
  </div>
</SiteLayout>
